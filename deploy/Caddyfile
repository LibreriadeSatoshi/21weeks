# App origin (e.g. app.ismos.xyz). Netlify proxies from
# ismos.xyz/21weeks/* to here; the API is called directly on this domain.
{$DOMAIN} {
	encode zstd gzip

	# There is nothing outside the prefix: redirect to the app.
	@outside not path {$BASE_PATH}*
	redir @outside {$BASE_PATH} 302

	reverse_proxy app:3000 {
		# The mentor chat streams: do not buffer the response.
		flush_interval -1
	}
}
